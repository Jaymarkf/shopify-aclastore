{% javascript %}
  class AclaProductFamily extends HTMLElement {
    connectedCallback() {
      if (this.controller) return;
      this.controller = new AbortController();
      this.items = [...this.querySelectorAll('[data-family-item]')];
      this.strings = JSON.parse(this.querySelector('[data-family-strings]').textContent);
      this.formatter = new Intl.NumberFormat(this.dataset.locale || document.documentElement.lang || 'en', { style: 'currency', currency: this.dataset.currency || 'USD' });
      this.pending = false;
      this.uncertain = false;
      this.motion = matchMedia('(prefers-reduced-motion: reduce)');
      this.animations = new Set();
      this.flights = new Set();
      this.descriptionInert = new Set();
      this.motion.addEventListener('change', () => {
        if (!this.motion.matches) return;
        this.animations.forEach(animation => animation.cancel());
        this.flights.forEach(flight => flight.remove());
        this.flights.clear();
      }, { signal: this.controller.signal });
      this.addEventListener('click', event => this.handleClick(event), { signal: this.controller.signal });
      this.addEventListener('change', event => this.handleChange(event), { signal: this.controller.signal });
      this.addEventListener('input', event => {
        if (event.target.matches('[data-family-quantity]')) this.updateSummary();
      }, { signal: this.controller.signal });
      this.querySelector('[data-family-search]')?.addEventListener('input', () => this.filterItems(), { signal: this.controller.signal });
      document.addEventListener('shopify:cart:lines-update', event => {
        event.promise?.then(({ cart, detail }) => {
          if (detail?.source === this.id) return;
          if (detail?.items) this.syncCart({ items: detail.items });
          else if (cart) this.refreshCart().then(value => this.syncCart(value)).catch(() => {});
        }).catch(() => {});
      }, { signal: this.controller.signal });
      document.addEventListener('acla:cart-snapshot', event => this.syncCart(event.detail.cart), { signal: this.controller.signal });
      this.querySelector('[data-image-dialog]')?.addEventListener('click', event => {
        if (event.target === event.currentTarget) event.currentTarget.close();
      }, { signal: this.controller.signal });
      this.observer = new IntersectionObserver(entries => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          this.querySelectorAll('.acla-family__tabs a').forEach(link => link.classList.toggle('is-active', link.hash === '#' + entry.target.id));
        }
      }, { rootMargin: '-20% 0px -65% 0px', threshold: 0 });
      this.querySelectorAll('.acla-family__shop,.acla-family__questions,.acla-family__reviews').forEach(section => this.observer.observe(section));
      const description = this.querySelector('[data-description-content]');
      if (description) {
        this.descriptionObserver = new ResizeObserver(() => this.updateDescription());
        this.descriptionObserver.observe(description);
        this.updateDescription();
      }
      this.revealObserver = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          this.revealObserver.unobserve(entry.target);
          this.animateElement(entry.target, [{ opacity: .25, transform: 'translateY(10px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 650, delay: Number(entry.target.dataset.position || 0) % 8 * 30 });
        });
      }, { threshold: .08 });
      this.querySelectorAll('.acla-family__section-heading,.acla-family__toolbar,.acla-family__questions,.acla-family__reviews,[data-family-item]').forEach(element => this.revealObserver.observe(element));
      this.updateSummary();
    }

    disconnectedCallback() {
      this.controller?.abort();
      this.observer?.disconnect();
      this.descriptionObserver?.disconnect();
      this.revealObserver?.disconnect();
      this.animations?.forEach(animation => animation.cancel());
      this.flights?.forEach(flight => flight.remove());
      this.descriptionInert?.forEach(element => element.inert = false);
      this.controller = null;
    }

    animateElement(element, frames, options = {}) {
      if (!element || this.motion.matches || !this.isConnected) return null;
      const animation = element.animate(frames, { duration: 480, easing: 'cubic-bezier(.2,.7,.2,1)', ...options });
      this.animations.add(animation);
      animation.finished.then(() => this.animations.delete(animation), () => this.animations.delete(animation));
      return animation;
    }
    updateDescription(expanded = this.descriptionExpanded || false, animate = false) {
      const wrap = this.querySelector('[data-description-wrap]');
      if (!wrap) return;
