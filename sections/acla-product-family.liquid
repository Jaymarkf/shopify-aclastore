{% comment %}
  Independent product group with searchable, deferred option details.
  @example Assign the product-family template to a display parent.
{% endcomment %}
{% liquid
  assign family_products = product.metafields.custom.family_products.value
  assign family_more_products = product.metafields.custom.family_products_more.value
  assign family_count = family_products.count | default: 0
  assign family_more_count = family_more_products.count | default: 0
  assign family_count = family_count | plus: family_more_count
  assign family_page_size = 24
  if family_products == blank
    assign family_products = family_more_products
  endif
  if family_count == 0
    assign family_products = section.settings.products
    assign family_count = family_products.size | default: 0
    assign family_page_size = 50
  endif
  assign family_collection = product.metafields.custom.family_collection.value
  if family_collection != blank
    assign family_products = family_collection.products
    assign family_count = family_collection.products_count
    assign family_page_size = 24
  endif
  assign initial_count = 0
  assign minimum_price = product.price
  assign family_seen_ids = product.id | prepend: '|' | append: '|'
  assign family_structured_entries = ''
  assign family_catalog_entries = ''
  assign hero_image = product.featured_image | default: family_products.first.featured_image
  assign hero_alt = hero_image.alt | default: product.title
  assign question_count = section.blocks | where: 'type', 'question' | size
  assign app_count = section.blocks | where: 'type', '@app' | size
%}

{% capture family_items %}
  {% if family_products != blank %}
      {% for family_product in family_products limit: family_page_size %}
        {% assign family_item_key = family_product.id | prepend: '|' | append: '|' %}
        {% unless family_seen_ids contains family_item_key %}
          {% assign family_seen_ids = family_seen_ids | append: family_item_key %}
          {% assign initial_count = initial_count | plus: 1 %}
          {% render 'acla-family-item', item_product: family_product, family_id: section.id, position: initial_count %}
          {% capture catalog_entry %}{% if initial_count > 1 %},{% endif %}{% render 'acla-family-item', item_product: family_product, family_id: section.id, position: initial_count, format: 'json' %}{% endcapture %}
          {% assign family_catalog_entries = family_catalog_entries | append: catalog_entry %}
          {% capture structured_entry %}{% if initial_count > 1 %},{% endif %}{"@type":"ListItem","position":{{ initial_count }},"name":{{ family_product.title | json }},"url":{{ request.origin | append: family_product.url | json }}}{% endcapture %}
          {% assign family_structured_entries = family_structured_entries | append: structured_entry %}
        {% endunless %}
      {% endfor %}
  {% endif %}
{% endcapture %}
{% capture family_cart_status %}{% render 'acla-cart-status', product_resource: product %}{% endcapture %}

<acla-product-family
  class="acla-family"
  id="ProductFamily-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  {% if product.handle == 'olo-premium-markers-brush' or product.handle == 'copic-ciao' %}data-mobile-color-lines{% endif %}
  data-option-count="{{ family_count }}"
  data-scale-module="{{ 'acla-family-scale.js' | asset_url }}"
  {% if family_collection != blank %}
    data-index-url="{{ family_collection.url }}?view=family-index"
    data-records-url="{{ family_collection.url }}?view=family-records"
  {% endif %}
  data-scale-test-count="{% if product.id == section.settings.performance_test_product.id %}{{ section.settings.performance_test_count }}{% else %}0{% endif %}"
  data-catalog-url="{{ product.url }}?view=family-options"
  data-view="{{ section.settings.default_view }}"
  data-currency="{{ localization.country.currency.iso_code }}"
  data-locale="{{ request.locale.iso_code }}"
  data-cart-add-url="{{ routes.cart_add_url }}.js"
  data-cart-url="{{ routes.cart_url }}"
  style="--family-accent: {{ section.settings.accent_color }}; --family-padding-top: {{ section.settings.padding_top }}px; --family-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="acla-family__container">
    <nav class="acla-family__breadcrumb" aria-label="{{ 'acla_family.breadcrumb' | t }}">
      <a href="{{ routes.root_url }}">{{ 'acla_family.home' | t }}</a>
      <span aria-hidden="true">/</span>
      <a href="{{ routes.all_products_collection_url }}">{{ 'acla_family.art_supplies' | t }}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ product.title | escape }}</span>
    </nav>

    <div class="acla-family__hero">
      <div class="acla-family__gallery">
        <button class="acla-family__main-image" type="button" data-open-image aria-label="{{ 'acla_family.zoom_image' | t }}"{% if hero_image == blank %} disabled{% endif %}>
          {% if hero_image %}
            {% assign hero_image_id = 'FamilyHeroImage-' | append: section.id %}
            {{ hero_image | image_url: width: 1200 | image_tag: widths: '400, 600, 900, 1200', sizes: '(min-width: 990px) 560px, (min-width: 750px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: hero_alt, id: hero_image_id, data-main-image: '' }}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'acla-family__placeholder' }}
          {% endif %}
          <span class="acla-family__zoom-icon" aria-hidden="true">⌕</span>
        </button>
        {% render 'acla-family-thumbnails', images: product.images, product_title: product.title, section_id: section.id %}
        <p class="acla-family__image-note">{{ 'acla_family.image_note' | t }}</p>
      </div>

      <div class="acla-family__intro">
        {% if product.vendor != blank %}<p class="acla-family__brand">{{ product.vendor | escape }}</p>{% endif %}
        <h1>{{ product.title | escape }}</h1>
        {% if product.metafields.reviews.rating.value != blank %}
          <p class="acla-family__rating">
            <span aria-hidden="true">★</span>
            {{ product.metafields.reviews.rating.value.rating }} / {{ product.metafields.reviews.rating.value.scale_max }}
            {% if product.metafields.reviews.rating_count.value != blank %}
              <span>({{ product.metafields.reviews.rating_count.value }})</span>
            {% endif %}
          </p>
        {% endif %}
        {% if family_count > 0 %}
          <p class="acla-family__list-price" data-family-msrp hidden>{{ 'acla_pricing.msrp' | t }} <span data-family-msrp-value></span></p>
          <p class="acla-family__hero-price">
            <span>{{ 'acla_pricing.selling_price' | t }}</span>
            <span data-family-price-from{% if family_count <= initial_count %} hidden{% endif %}>{{ 'acla_family.from' | t }}</span>
            <strong data-family-price>{{ minimum_price | money }}</strong><span>{{ 'acla_family.each' | t }}</span>
            {% render 'acla-promotion-badge', product_resource: product %}
            {{ family_cart_status }}
          </p>
        {% endif %}
        {% if product.description != blank %}
          <div class="acla-family__description-wrap" data-description-wrap>
            <div id="FamilyDescription-{{ section.id }}" class="acla-family__description-window" data-description-window>
              <div class="acla-family__description rte" data-description-content>{{ product.description }}</div>
            </div>
            <button type="button" class="acla-family__text-link acla-family__description-toggle" data-description-toggle aria-expanded="false" aria-controls="FamilyDescription-{{ section.id }}" hidden>
              <span data-description-label>{{ 'acla_family.read_more' | t }}</span><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m5 7.5 5 5 5-5"/></svg>
            </button>
          </div>
        {% endif %}
        <div class="acla-family__intro-divider"></div>
        <div class="acla-family__shop-intro">
          <div>
            <strong>{{ 'acla_family.find_your_colors' | t }}</strong>
            <span>{{ 'acla_family.color_count' | t: count: family_count }}</span>
          </div>
          <a class="acla-family__button" href="#FamilyShop-{{ section.id }}">{{ 'acla_family.shop_colors' | t }} <span aria-hidden="true">↓</span></a>
        </div>
        <p class="acla-family__mix-note">{{ 'acla_family.mix_note' | t }}</p>
        {% if shop.shipping_policy.body != blank %}
          <a class="acla-family__text-link" href="{{ shop.shipping_policy.url }}">{{ 'acla_family.shipping_details' | t }}</a>
        {% endif %}
      </div>
    </div>

    <nav class="acla-family__tabs" aria-label="{{ 'acla_family.page_navigation' | t }}">
      <a href="#FamilyShop-{{ section.id }}" class="is-active">{{ 'acla_family.shop_products' | t }} <span>{{ family_count }}</span></a>
      {% if question_count > 0 %}<a href="#FamilyQuestions-{{ section.id }}">{{ 'acla_family.questions' | t }}</a>{% endif %}
      {% if app_count > 0 %}<a href="#FamilyReviews-{{ section.id }}">{{ 'acla_family.reviews' | t }}</a>{% endif %}
    </nav>

    <section class="acla-family__shop" id="FamilyShop-{{ section.id }}" aria-labelledby="FamilyShopTitle-{{ section.id }}">
      <div class="acla-family__section-heading">
        <div><p class="acla-family__eyebrow">{{ 'acla_family.build_your_palette' | t }}</p><h2 id="FamilyShopTitle-{{ section.id }}">{{ 'acla_family.shop_colors' | t }}</h2></div>
        <p>{{ 'acla_family.choose_quantities' | t }}</p>
      </div>
      {% if family_count > 0 %}
        <div class="acla-family__toolbar">
          <div class="acla-family__search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
            <label class="visually-hidden" for="FamilySearch-{{ section.id }}">{{ 'acla_family.search_colors' | t }}</label>
            <input id="FamilySearch-{{ section.id }}" type="search" data-family-search placeholder="{{ 'acla_family.search_placeholder' | t }}" autocomplete="off">
          </div>
          <label class="acla-family__stock-filter"><input type="checkbox" data-in-stock-only> {{ 'acla_family.in_stock_only' | t }}</label>
          <div class="acla-family__sort">
            <label class="visually-hidden" for="FamilySort-{{ section.id }}">{{ 'acla_family.sort_by' | t }}</label>
            <select id="FamilySort-{{ section.id }}" data-family-sort>
              <option value="position">{{ 'acla_family.sort_featured' | t }}</option>
              <option value="name">{{ 'acla_family.sort_name' | t }}</option>
              <option value="price_asc">{{ 'acla_family.sort_price_low' | t }}</option>
              <option value="price_desc">{{ 'acla_family.sort_price_high' | t }}</option>
            </select>
          </div>
          <div class="acla-family__view-buttons" role="group" aria-label="{{ 'acla_family.display_view' | t }}">
            <button type="button" data-family-view="grid" aria-label="{{ 'acla_family.grid_view' | t }}" aria-pressed="{% if section.settings.default_view == 'grid' %}true{% else %}false{% endif %}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"/></svg>
            </button>
            <button type="button" data-family-view="list" aria-label="{{ 'acla_family.list_view' | t }}" aria-pressed="{% if section.settings.default_view == 'list' %}true{% else %}false{% endif %}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 5h12M9 12h12M9 19h12M3 4h2v2H3zM3 11h2v2H3zM3 18h2v2H3z"/></svg>
            </button>
          </div>
        </div>
        {% assign initial_visible_count = family_count | at_most: family_page_size %}
        <div class="acla-family__results-meta"><p data-result-count role="status" tabindex="-1">{{ 'acla_family.results_count' | t: shown: initial_visible_count, total: family_count }}</p><span>{{ 'acla_family.swatch_note' | t }}</span></div>

        <div class="acla-family__selection" id="FamilySelection-{{ section.id }}" data-color-selection hidden>
          <div class="acla-family__selection-image"><img data-selected-image width="260" height="220" alt="" loading="lazy"></div>
          <div class="acla-family__selection-info">
            <p class="acla-family__eyebrow">{{ 'acla_family.selected_color' | t }}</p>
            <h3 data-selected-name></h3>
            <p class="acla-family__selection-sku">{{ 'acla_family.sku' | t }} <span data-selected-sku></span></p>
            <p class="acla-family__selection-msrp"><span>{{ 'acla_pricing.msrp' | t }}</span> <span data-selected-msrp></span></p>
            <p class="acla-family__selection-price"><span>{{ 'acla_pricing.selling_price' | t }}</span> <strong data-selected-price></strong> <span>{{ 'acla_family.each' | t }}</span></p>
            <p data-selected-availability></p>
            {{ family_cart_status }}
            <div class="acla-family__selection-actions">
              <label class="visually-hidden" for="FamilySingleQuantity-{{ section.id }}">{{ 'acla_family.quantity' | t }}</label>
              <input id="FamilySingleQuantity-{{ section.id }}" type="number" data-selected-quantity value="1" min="1" inputmode="numeric" autocomplete="off">
              <button type="button" class="acla-family__button" data-add-single data-cart-action>{{ 'acla_family.add_to_cart' | t }}</button>
            </div>
            <a class="acla-family__text-link" data-selected-link>{{ 'acla_family.item_details' | t }} <span aria-hidden="true">↗</span></a>
          </div>
          <button type="button" class="acla-family__close" data-close-selection aria-label="{{ 'acla_family.close_preview' | t }}">×</button>
        </div>

        <div class="acla-family__list-heading" aria-hidden="true"><span>{{ 'acla_family.color' | t }}</span><span>{{ 'acla_family.sku' | t }}</span><span>{{ 'acla_family.price' | t }}</span><span>{{ 'acla_family.availability' | t }}</span><span>{{ 'acla_family.quantity' | t }}</span><span></span></div>
        <ul class="acla-family__items" id="FamilyItems-{{ section.id }}" data-family-items aria-label="{{ 'acla_family.available_colors' | t }}">
          {{ family_items }}
        </ul>
        <div class="acla-family__more" data-family-more hidden>
          <span data-scroll-status aria-hidden="true" hidden>{{ 'acla_family.loading_options' | t }}</span>
          <button type="button" class="acla-family__button" data-retry-options aria-controls="FamilyItems-{{ section.id }}" hidden>{{ 'acla_family.retry_options' | t }}</button>
        </div>
        <div class="acla-family__empty-results" data-empty-results hidden><p>{{ 'acla_family.no_results' | t }}</p><button type="button" class="acla-family__text-link" data-clear-filters>{{ 'acla_family.clear_filters' | t }}</button></div>
        <div class="acla-family__feedback" data-family-feedback role="status" aria-live="polite" tabindex="-1" hidden></div>

        <div class="acla-family__order-bar">
          <div class="acla-family__order-count"><strong data-selected-count>{{ 'acla_family.selected_count' | t: count: 0 }}</strong><button type="button" data-clear-selection disabled>{{ 'acla_family.clear_selection' | t }}</button></div>
          <div class="acla-family__order-total"><span>{{ 'acla_family.subtotal' | t }}</span><strong data-selected-total>{{ 0 | money }}</strong></div>
          <button type="button" class="acla-family__button acla-family__add-selected" data-add-selected data-cart-action disabled>{{ 'acla_family.add_selected' | t }} <span aria-hidden="true">→</span></button>
        </div>
        <noscript><p>{{ 'acla_family.no_javascript' | t }}</p><p><a href="{{ product.url }}?view=family-options">{{ 'acla_family.view_all_options' | t }}</a></p><style>.acla-family__quantity,.acla-family__order-bar,.acla-family__toolbar{display:none!important}.acla-family__item-link{display:block!important}</style></noscript>
      {% else %}
        <div class="acla-family__empty-results">
          {% if request.design_mode %}<p>{{ 'acla_family.editor_empty' | t }}</p>{% else %}<p>{{ 'acla_family.empty_group' | t }}</p>{% endif %}
        </div>
      {% endif %}
    </section>

    {% if question_count > 0 %}
      <section class="acla-family__questions" id="FamilyQuestions-{{ section.id }}" aria-labelledby="FamilyQuestionsTitle-{{ section.id }}">
        <h2 id="FamilyQuestionsTitle-{{ section.id }}">{{ 'acla_family.questions' | t }}</h2>
        {% for block in section.blocks %}
          {% if block.type == 'question' %}
            <details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}<span aria-hidden="true">+</span></summary><div>{{ block.settings.answer }}</div></details>
          {% endif %}
        {% endfor %}
      </section>
    {% endif %}
    {% if app_count > 0 %}
      <section class="acla-family__reviews" id="FamilyReviews-{{ section.id }}" aria-label="{{ 'acla_family.reviews' | t }}">
        {% for block in section.blocks %}{% if block.type == '@app' %}{% render block %}{% endif %}{% endfor %}
      </section>
    {% endif %}
  </div>

  <dialog class="acla-family__image-dialog" data-image-dialog aria-label="{{ 'acla_family.image_preview' | t }}">
    <button type="button" class="acla-family__close" data-close-image aria-label="{{ 'acla_family.close_preview' | t }}">×</button>
    <img data-zoom-image width="1200" height="1200" alt="">
  </dialog>
  <script type="application/json" data-family-strings>
    {
      "results": {{ 'acla_family.results_count' | t: shown: '[shown]', total: '[total]' | json }},
      "selected": {{ 'acla_family.selected_count' | t: count: '[count]' | json }},
      "in_stock": {{ 'acla_family.in_stock' | t | json }},
      "sold_out": {{ 'acla_family.sold_out' | t | json }},
      "cart_limit": {{ 'acla_family.cart_limit' | t | json }},
      "adding": {{ 'acla_family.adding' | t | json }},
      "add_selected": {{ 'acla_family.add_selected' | t | json }},
      "add_to_cart": {{ 'acla_family.add_to_cart' | t | json }},
      "added_one": {{ 'acla_family.added_one' | t | json }},
      "added_many": {{ 'acla_family.added_many' | t: count: '[count]' | json }},
      "view_cart": {{ 'acla_family.view_cart' | t | json }},
      "error": {{ 'acla_family.cart_error' | t | json }},
      "uncertain": {{ 'acla_family.cart_uncertain' | t | json }},
      "partial": {{ 'acla_family.cart_partial' | t | json }},
      "quantity_error": {{ 'acla_family.quantity_error' | t | json }},
      "read_more": {{ 'acla_family.read_more' | t | json }},
      "show_less": {{ 'acla_family.show_less' | t | json }},
      "preview_color": {{ 'acla_family.preview_color' | t: color: '[color]' | json }},
      "quantity_color": {{ 'acla_family.quantity_color' | t: color: '[color]' | json }},
      "decrease_color": {{ 'acla_family.decrease_color' | t: color: '[color]' | json }},
      "increase_color": {{ 'acla_family.increase_color' | t: color: '[color]' | json }},
      "view_options": {{ 'acla_family.view_options' | t | json }}
      ,"loading_options": {{ 'acla_family.loading_options' | t | json }}
      ,"load_error": {{ 'acla_family.load_error' | t | json }}
      ,"total_options": {{ 'acla_family.total_options' | t: count: '[count]' | json }}
      ,"performance_test": {{ 'acla_family.performance_test' | t: count: '[count]', real: '[real]' | json }}
      ,"test_cart_disabled": {{ 'acla_family.test_cart_disabled' | t | json }}
      ,"search_match": {{ 'acla_family.search_match' | t: product: '[product]' | json }}
      ,"retry_options": {{ 'acla_family.retry_options' | t | json }}
      ,"item_savings": {{ 'acla_savings.item' | t: percent: '[percent]' | json }}
      ,"checkout_savings_note": {{ 'acla_savings.checkout_note' | t | json }}
      ,"msrp_not_listed": {{ 'acla_pricing.not_listed' | t | json }}
    }
  </script>
  <script type="application/json" data-family-catalog>[{{ family_catalog_entries | replace: '<', '\u003c' }}]</script>
  {% if family_count > 0 %}
    <script type="application/ld+json">
      {"@context":"https://schema.org","@type":"ItemList","name":{{ product.title | json }},"numberOfItems":{{ family_count }},"itemListElement":[
        {{ family_structured_entries }}
      ]}
    </script>
  {% endif %}
</acla-product-family>

{% stylesheet %}
  .acla-family{display:block;color:#202522;background:#fff;font-family:var(--font-body--family,Arial,sans-serif);font-size:14px;line-height:1.55;padding-block:var(--family-padding-top) var(--family-padding-bottom);--family-border:#dfe4e0;--family-muted:#626b65;--family-soft:#f4f7f4;--family-radius:4px}
  .acla-family *, .acla-family *::before,.acla-family *::after{box-sizing:border-box}
  .acla-family [hidden]{display:none!important}
  .acla-family button,.acla-family input,.acla-family select{font:inherit;letter-spacing:normal}
  .acla-family button{cursor:pointer}
  .acla-family button:disabled{cursor:not-allowed;opacity:.48}
  .acla-family :is(button,a,input,select,summary):focus-visible{outline:2px solid var(--family-accent);outline-offset:4px}
  .acla-family a{color:inherit;text-decoration:none}
  .acla-family p{margin:0}
  .acla-family h1,.acla-family h2,.acla-family h3{font-family:var(--font-heading--family,inherit);font-weight:650;letter-spacing:-.035em;color:inherit;text-wrap:balance}
  .acla-family h1{font-size:clamp(1.375rem,1rem + .85vw,1.8125rem);font-weight:700;line-height:1.25;letter-spacing:-.02em;overflow-wrap:anywhere;margin:8px 0 18px}
  .acla-family h2{font-size:28px;line-height:1.2;margin:0 0 12px}
  .acla-family h3{font-size:25px;line-height:1.2;margin:4px 0 10px}
  .acla-family__container{max-width:1328px;margin-inline:auto;padding-inline:40px}
  .acla-family__breadcrumb{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:12px;color:var(--family-muted);margin-bottom:32px}
  .acla-family__breadcrumb a:hover{text-decoration:underline}
  .acla-family__breadcrumb [aria-current]{color:#292f2b}
  .acla-family__hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:80px;align-items:start;padding-bottom:48px}
  .acla-family__gallery{min-width:0}
  .acla-family__main-image{display:grid;place-items:center;position:relative;width:100%;aspect-ratio:1.18;background:#fff;border:1px solid #edf0ed;border-radius:var(--family-radius);padding:28px}
  .acla-family__main-image img{width:100%;height:100%;max-height:420px;object-fit:contain}
  .acla-family__placeholder{height:100%;width:100%}
  .acla-family__zoom-icon{position:absolute;right:14px;bottom:12px;display:grid;place-items:center;width:32px;height:32px;border:1px solid var(--family-border);border-radius:50%;background:#fff;font-size:24px;line-height:1}
  .acla-family__image-note{text-align:center;font-size:11px;color:var(--family-muted);margin-top:14px!important}
  .acla-family__brand{text-transform:uppercase;letter-spacing:.16em;font-size:12px;font-weight:700;color:var(--family-accent)}
  .acla-family__hero-price{display:flex;align-items:baseline;gap:8px;margin-bottom:18px!important}
  .acla-family__hero-price strong{font-size:29px;letter-spacing:-.03em}
  .acla-family__hero-price span{font-size:13px;color:var(--family-muted)}
  .acla-family__list-price{font-size:13px;color:var(--family-muted);margin-block-end:6px!important}
  .acla-family__description-wrap{--description-preview-height:190px}
  .acla-family__description-window{position:relative;display:flow-root}
  .acla-family__description-wrap[data-collapsible=true] .acla-family__description-window{overflow:clip}
