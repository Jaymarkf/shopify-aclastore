      label.textContent = this.strings.selected.replace('[count]', count);
      this.querySelector('[data-selected-total]').textContent = this.money(total);
      this.querySelector('[data-clear-selection]').disabled = this.pending || count === 0;
      const add = this.querySelector('[data-add-selected]');
      add.disabled = this.pending || count === 0 || invalid || this.uncertain || this.performanceTest;
      if (this.performanceTest) add.title = this.strings.test_cart_disabled;
      add.textContent = this.pending ? this.strings.adding : this.strings.add_selected;
      if (this.activeItem) {
        const maximum = this.maximum(this.activeItem);
        const available = this.activeItem.dataset.available === 'true' && maximum >= Number(this.activeItem.dataset.ruleMin || 1);
        const single = this.querySelector('[data-add-single]');
        single.disabled = this.pending || !available || this.uncertain || this.performanceTest;
        single.textContent = this.pending ? this.strings.adding : this.strings.add_to_cart;
        const input = this.querySelector('[data-selected-quantity]');
        input.disabled = this.pending || !available || this.uncertain;
        input.min = this.activeItem.dataset.ruleMin;
        input.step = this.activeItem.dataset.ruleIncrement;
        if (Number.isFinite(maximum)) input.max = maximum;
        else input.removeAttribute('max');
        this.querySelector('[data-selected-availability]').textContent = available ? this.strings.in_stock : this.strings.sold_out;
      }
    }
    feedback(message, error = false) {
      const box = this.querySelector('[data-family-feedback]');
      box.hidden = false;
      box.setAttribute('role', error ? 'alert' : 'status');
      box.dataset.error = String(error);
      box.textContent = message;
      const link = document.createElement('a');
      link.href = this.dataset.cartUrl;
      link.textContent = this.strings.view_cart;
      box.append(link);
      this.animateElement(box, [{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'translateY(0)' }]);
    }
    async refreshCart() {
      const response = await fetch(this.dataset.cartUrl + '.js', { headers: { Accept: 'application/json' } });
      if (!response.ok) throw new Error(this.strings.error);
      return response.json();
    }
    cartQuantities(cart) {
      const quantities = new Map();
      for (const line of cart.items || []) {
        const key = String(line.variant_id);
        quantities.set(key, (quantities.get(key) || 0) + line.quantity);
      }
      return quantities;
    }
    syncCart(cart) {
      const quantities = this.cartQuantities(cart);
      this.currentCartQuantities = quantities;
      this.items.forEach(item => {
        item.dataset.cartQuantity = quantities.get(item.dataset.variantId) || 0;
        const input = item.querySelector('[data-family-quantity]');
        input.value = this.normalize(item, Number(input.value));
      });
      this.filterItems(false);
    }
    async addItems(entries, origin) {
      if (this.performanceTest || this.pending || this.uncertain || entries.length === 0) return;
      const invalid = entries.some(({ item, quantity }) => !Number.isInteger(quantity) || this.normalize(item, quantity) !== quantity);
      if (invalid) return this.feedback(this.strings.quantity_error, true);
      const motion = new Map(entries.map(({ item }) => [item, this.cartMotion(item, origin)]));
      this.pending = true;
      this.updateSummary();
      this.setAttribute('aria-busy', 'true');
      let deferred;
      let EventClass;
      let before;
      let attempted = false;
      let cart;
      let responseData;
      let problem;
      try {
        before = await this.refreshCart();
        const actual = this.cartQuantities(before);
        const changed = entries.some(({ item, quantity }) => item.hasAttribute('data-stock') && Number(item.dataset.stock) - (actual.get(item.dataset.variantId) || 0) < quantity);
        if (changed) {
          this.syncCart(before);
          throw new Error(this.strings.quantity_error);
        }
        try {
          ({ CartLinesUpdateEvent: EventClass } = await import('@shopify/events'));
          deferred = EventClass.createPromise();
          this.dispatchEvent(new EventClass({ action: 'add', context: 'product', lines: entries.map(({ item, quantity }) => ({ merchandiseId: item.dataset.variantId, quantity })), promise: deferred.promise }));
        } catch { EventClass = null; }
        const sections = [...new Set([...document.querySelectorAll('cart-items-component[data-section-id]')].map(element => element.dataset.sectionId))].filter(Boolean).slice(0, 5);
        const payload = { items: entries.map(({ item, quantity }) => ({ id: Number(item.dataset.variantId), quantity })) };
        if (sections.length) {
          payload.sections = sections;
          payload.sections_url = location.pathname;
        }
        attempted = true;
        const response = await fetch(this.dataset.cartAddUrl, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(payload) });
        responseData = await response.json();
        if (!response.ok || responseData.status) throw new Error(typeof responseData.description === 'string' ? responseData.description : this.strings.error);
      } catch (error) { problem = error; }
      if (attempted) {
        try { cart = await this.refreshCart(); }
        catch {
          this.uncertain = true;
          problem = new Error(this.strings.uncertain);
        }
      }
      if (cart && before) {
        const previous = this.cartQuantities(before);
        const current = this.cartQuantities(cart);
        let added = 0;
        const addedMotion = [];
        for (const { item, quantity, batch } of entries) {
          const delta = problem ? Math.max(0, (current.get(item.dataset.variantId) || 0) - (previous.get(item.dataset.variantId) || 0)) : quantity;
          added += delta;
          if (delta > 0) addedMotion.push(motion.get(item));
          if (batch) item.querySelector('[data-family-quantity]').value = Math.max(0, this.quantity(item) - delta);
        }
        this.syncCart(cart);
        deferred?.resolve({ cart: EventClass.createCartFromAjaxResponse(cart), detail: { source: this.id, sourceId: this.id, items: cart.items, itemCount: cart.item_count, sections: responseData?.sections, didError: Boolean(problem) } });
        if (addedMotion.length) requestAnimationFrame(() => this.animateCart(addedMotion));
        if (problem) this.feedback((added ? this.strings.partial + ' ' : '') + problem.message, true);
        else this.feedback(added === 1 ? this.strings.added_one : this.strings.added_many.replace('[count]', added));
      } else {
        deferred?.reject(problem || new Error(this.strings.error));
        this.feedback(problem?.message || this.strings.error, true);
      }
      this.pending = false;
      this.removeAttribute('aria-busy');
      this.updateSummary();
    }
  }
  if (!customElements.get('acla-product-family')) customElements.define('acla-product-family', AclaProductFamily);
{% endjavascript %}

