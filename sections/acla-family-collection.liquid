{% assign context = 'collection' %}
{% liquid
  assign catalog = settings.catalog_groups | default: collections['storefront-product-groups'] | default: collections.markers
  assign query = ''
  assign target = collection
  assign sort_by = collection.sort_by | default: 'manual'
  if context == 'search'
    assign query = search.terms
    assign target = nil
    assign sort_by = search.sort_by | default: 'manual'
  endif
%}
{% capture parent_ids %}{% if context == 'search' %}{% render 'acla-search-parent-ids', products: search.results %}{% endif %}{% endcapture %}
{% render 'collection-wrapper-styles' %}
{% render 'product-card-styles' %}
{% render 'text-block-styles' %}
{% render 'price-styles' %}
{% render 'product-card-gallery-zoom-details-styles' %}
<script src="{{ 'results-list.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% paginate catalog.products by 250 %}
  {% liquid
    assign candidates = catalog.products
    case sort_by
      when 'title-ascending'
        assign candidates = candidates | sort_natural: 'title'
      when 'title-descending'
        assign candidates = candidates | sort_natural: 'title' | reverse
      when 'price-ascending'
        assign candidates = candidates | sort: 'price'
      when 'price-descending'
        assign candidates = candidates | sort: 'price' | reverse
    endcase
    assign group_count = 0
  %}
  {% capture children %}
    {% for product in candidates %}
      {% capture visible %}{% render 'acla-group-visible', product_resource: product, target_collection: target, query: query, parent_ids: parent_ids %}{% endcapture %}
      {% if visible == 'true' %}
        {% assign group_count = group_count | plus: 1 %}
        <li class="product-grid__item" id="{{ section.id }}-{{ product.id }}" data-product-id="{{ product.id }}" data-group-card data-page="{{ paginate.current_page }}" ref="cards[]">
          {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product, product_view_context: context %}
        </li>
      {% endif %}
    {% endfor %}
  {% endcapture %}
{% render 'acla-group-results', section: section, context: context, children: children, group_count: group_count, candidates: candidates, paginate: paginate, sort_by: sort_by %}
{% endpaginate %}
{% schema %}
{
  "name": "t:acla_collections.section_name",
  "enabled_on": {
    "templates": [
      "collection"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:acla_collections.setup_help"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": []
}
{% endschema %}
