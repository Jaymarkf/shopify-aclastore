{% doc %}
  Native menu categories in a horizontal row with selected children in a grid below.
  @param {object} parent_link - Native menu item containing the categories
  @param {string} menu_id - Unique prefix for the panels
  @example
  {% render 'acla-brand-menu', parent_link: link, menu_id: list_id %}
{% enddoc %}

<script src="{{ 'acla-brand-menu.js' | asset_url }}" type="module" fetchpriority="low"></script>
<acla-brand-menu class="acla-brand-menu">
  <ul class="acla-brand-menu__brands list-unstyled">
    {% for brand_link in parent_link.links %}
      <li class="acla-brand-menu__brand">
        {% if brand_link.links != blank %}
          <button
            class="button-unstyled acla-brand-menu__toggle"
            type="button"
            ref="toggles[]"
            aria-expanded="false"
            aria-controls="{{ menu_id }}-Brand-{{ forloop.index }}"
            on:click="/toggleBrand"
          >
            <span>{{ brand_link.title | escape }}</span>
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" aria-hidden="true"><path d="m3 6 5 5 5-5"/></svg>
          </button>
        {% else %}
          <a href="{{ brand_link.url }}" class="acla-brand-menu__category-link">{{ brand_link.title | escape }}</a>
        {% endif %}
      </li>
    {% endfor %}
    <li class="acla-brand-menu__overview">
      <a href="{{ parent_link.url }}">{{ 'acla_navigation.view_all' | t: title: parent_link.title | escape }} <span aria-hidden="true">↗</span></a>
    </li>
  </ul>
  {% for brand_link in parent_link.links %}
    {% if brand_link.links != blank %}
      <div class="acla-brand-menu__panel" id="{{ menu_id }}-Brand-{{ forloop.index }}" ref="panels[]" hidden>
        <ul class="acla-brand-menu__families list-unstyled">
          <li><a href="{{ brand_link.url }}" class="acla-brand-menu__view-all">{{ 'acla_navigation.view_all' | t: title: brand_link.title | escape }} <span aria-hidden="true">↗</span></a></li>
          {% for family_link in brand_link.links %}
            <li><a href="{{ family_link.url }}"{% if family_link.current %} aria-current="page"{% endif %}>{{ family_link.title | escape }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  {% endfor %}
</acla-brand-menu>

{% stylesheet %}
  .acla-brand-menu {
    display: block;
    grid-column: 1 / -1;
    inline-size: 100%;
    min-inline-size: 0;
    margin-block: var(--margin-xs);
    padding: clamp(12px, 1.4vw, 22px);
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
    border-radius: var(--style-border-radius-popover);
    background: rgb(var(--color-background-rgb) / 0.97);
    color: var(--color-foreground);
    box-shadow: 0 8px 28px rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  .acla-brand-menu__brands {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap-sm);
    min-inline-size: 0;
  }

  .acla-brand-menu__brand { min-inline-size: 0; }

  .acla-brand-menu__toggle,
  .acla-brand-menu__category-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-xl);
    min-inline-size: 120px;
    min-block-size: var(--minimum-touch-target);
    max-inline-size: 100%;
    padding: var(--padding-sm) var(--padding-md);
    border-radius: var(--style-border-radius-buttons-primary);
    color: var(--color-foreground);
    font-family: var(--menu-parent-font-family);
    font-size: var(--menu-parent-font-size);
    font-weight: var(--menu-parent-font-weight);
    text-decoration: none;
    text-align: start;
    overflow-wrap: anywhere;
    transition: background-color var(--animation-speed) var(--animation-easing);
  }

  .acla-brand-menu__toggle:hover,
  .acla-brand-menu__category-link:hover,
  .acla-brand-menu__toggle[aria-expanded='true'] {
    background: rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  .acla-brand-menu__toggle[aria-expanded='true'] { box-shadow: inset 0 -2px 0 currentColor; }

  .acla-brand-menu__toggle svg { flex: 0 0 16px; transition: transform var(--animation-speed) var(--animation-easing); }
  .acla-brand-menu__toggle[aria-expanded='true'] svg { transform: rotate(180deg); }
  .acla-brand-menu__overview { margin-inline-start: auto; }

  .acla-brand-menu__overview a {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-xs);
    min-block-size: var(--minimum-touch-target);
    padding-inline: var(--padding-sm);
    color: inherit;
    font-size: var(--font-size--sm);
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
  }

  .acla-brand-menu__panel {
    margin-block-start: var(--margin-sm);
    padding-block-start: var(--padding-md);
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  .acla-brand-menu__panel[hidden] { display: none; }

  .acla-brand-menu__families {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: var(--gap-xs) var(--gap-md);
    min-inline-size: 0;
  }

  .acla-brand-menu__families li { min-inline-size: 0; }

  .acla-brand-menu__families a {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    min-block-size: var(--minimum-touch-target);
    block-size: 100%;
    padding: var(--padding-sm);
    border-radius: var(--style-border-radius-buttons-primary);
    color: var(--color-foreground);
    font-family: var(--menu-child-font-family);
    font-size: var(--menu-child-font-size);
    line-height: 1.45;
    text-decoration: none;
    white-space: normal;
    min-inline-size: 0;
    overflow-wrap: anywhere;
    transition: background-color var(--animation-speed) var(--animation-easing);
  }

  .acla-brand-menu__families a:is(:hover, [aria-current='page']) { background: rgb(var(--color-foreground-rgb) / var(--opacity-5)); }
  .acla-brand-menu__view-all { font-weight: 650; text-decoration: underline; text-underline-offset: 4px; }
  .acla-brand-menu :is(a, button):focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .acla-brand-menu :is(a, button, svg) { transition: none; } }
{% endstylesheet %}
