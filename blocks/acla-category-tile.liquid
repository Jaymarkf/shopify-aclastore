{% doc %}
  A category tile containing an optional first image/link and nested image slides.
  A stable native carousel whose DOM is updated immediately by the theme editor.
  The tile component handles unsaved slide additions, removals, and image changes.
  @example
  <!-- Add a Category tile block to Category tiles or a custom section. -->
{% enddoc %}
{% render 'acla-category-tile-styles' %}
{% capture children %}{% content_for 'blocks' %}{% endcapture %}
{% if block.settings.image != blank or children contains '<img' or request.design_mode %}
  {% capture first_media %}
    {% if block.settings.image != blank %}{% render 'acla-category-tile-media', image: block.settings.image, link: block.settings.link %}{% endif %}
  {% endcapture %}
  {% capture slides %}
    {% if block.settings.image != blank %}
      {% assign slide_id = block.id | append: '-first' %}
      {% render 'slideshow-slide', children: first_media, index: 0, slide_id: slide_id, class: 'acla-category-tile__slide' %}
    {% endif %}
    {{ children }}
  {% endcapture %}
  <acla-category-tile class="acla-category-tile" data-category-tile {{ block.shopify_attributes }}>
    {% capture carousel_attributes %}aria-label="{{ 'acla_category_tiles.slideshow' | t | escape }}"{% endcapture %}
    {% render 'slideshow', slides: slides, slide_count: 0, class: 'acla-category-tile__carousel', attributes: carousel_attributes, show_arrows: true, animate_arrows: false, infinite: false, icon_style: 'arrow', icon_shape: 'circle' %}
    {% if request.design_mode %}<span class="acla-category-tile__empty">{{ 'acla_category_tiles.choose_image' | t }}</span>{% endif %}
    <noscript>
      <div class="acla-category-tile__fallback">
        {{ first_media }}
        {{ children }}
      </div>
    </noscript>
    <script src="{{ 'acla-category-tile.js' | asset_url }}" type="module" fetchpriority="low"></script>
  </acla-category-tile>
{% endif %}
{% schema %}
{
  "name": "t:acla_category_tiles.tile_name",
  "tag": null,
  "blocks": [{ "type": "_acla-category-tile-slide" }],
  "settings": [
    { "type": "paragraph", "content": "t:acla_category_tiles.slides_help" },
    { "type": "image_picker", "id": "image", "label": "t:settings.image" },
    { "type": "url", "id": "link", "label": "t:settings.link" }
  ],
  "presets": [{ "name": "t:acla_category_tiles.tile_name", "category": "t:categories.basic" }]
}
{% endschema %}
